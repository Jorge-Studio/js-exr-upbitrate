{
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "example.png" }
  },

  "10": {
    "class_type": "PrepareImageHighBitDepth",
    "inputs": {
      "image": ["1", 0],
      "input_is_srgb": true,
      "add_headroom": 0.1,
      "deband_strength": 1.0
    }
  },

  "15": {
    "class_type": "ShadowCurveProcessor",
    "inputs": {
      "image": ["10", 0],
      "shadow_power": 2.0,
      "shadow_threshold": 0.15,
      "blend_width": 0.1,
      "preserve_color": true,
      "input_colorspace": "Linear"
    }
  },

  "20": {
    "class_type": "SceneSegmenter",
    "inputs": {
      "image": ["15", 0],
      "text_prompts": "sky, clouds, trees, foliage, ground, building, person, water, rock",
      "detection_backend": "auto",
      "model_size": "large",
      "auto_describe": true,
      "detail_level": 0.6,
      "min_area_percent": 1.0
    }
  },
  "21": {
    "class_type": "SegmentationPreview",
    "inputs": {
      "image": ["15", 0],
      "masks": ["20", 0],
      "layer_info": ["20", 2],
      "overlay_opacity": 0.5,
      "show_labels": true
    }
  },
  "22": {
    "class_type": "PreviewImage",
    "inputs": { "images": ["21", 0] },
    "_meta": { "title": "Segmentation Map" }
  },

  "30": {
    "class_type": "BatchLayerFractalProcessor",
    "inputs": {
      "images": ["15", 0],
      "masks": ["20", 0],
      "layer_info": ["20", 2],
      "seed": 42,
      "global_fractal_mult": 1.0,
      "global_smooth_mult": 1.0
    }
  },

  "40": {
    "class_type": "LayerAssembler",
    "inputs": {
      "layers": ["30", 0],
      "masks": ["20", 0],
      "feather_radius": 3,
      "output_colorspace": "passthrough",
      "background_color": 0.0
    }
  },

  "45": {
    "class_type": "PerceptualDither",
    "inputs": {
      "image": ["40", 0],
      "method": "blue_noise",
      "strength": 0.2,
      "target_bits": "16",
      "seed": 42
    }
  },

  "50": {
    "class_type": "ColorGradingController",
    "inputs": {
      "image": ["45", 0],
      "exposure": 0.0,
      "contrast": 1.0,
      "lift": 0.0,
      "gamma": 1.0,
      "gain": 1.0,
      "saturation": 1.0,
      "input_is_linear": true
    }
  },

  "55": {
    "class_type": "HDRCurveEditor",
    "inputs": {
      "image": ["50", 0],
      "shadows": 0.0,
      "midtones": 0.0,
      "highlights": 0.0,
      "whites": 0.0,
      "blacks": 0.0
    }
  },

  "58": {
    "class_type": "ColorMatchToReference",
    "inputs": {
      "processed_image": ["55", 0],
      "reference_image": ["1", 0],
      "match_luminance": true,
      "match_contrast": true,
      "match_colors": true,
      "strength": 0.5,
      "preserve_hdr_headroom": true
    }
  },

  "60": {
    "class_type": "BitDepthValidator",
    "inputs": {
      "expanded_image": ["58", 0],
      "original_image": ["1", 0],
      "waveform_height": 256
    }
  },

  "65": {
    "class_type": "ImageStats",
    "inputs": {
      "image": ["58", 0]
    }
  },

  "70": {
    "class_type": "SaveImageEXR",
    "inputs": {
      "image": ["58", 0],
      "filename_prefix": "ultimate_pipeline",
      "bit_depth": "32",
      "compression": "piz",
      "output_format": "Linear",
      "input_is_linear": true
    }
  },

  "75": {
    "class_type": "Rec709Converter",
    "inputs": {
      "image": ["58", 0],
      "source_colorspace": "Linear sRGB",
      "target_colorspace": "Rec.709",
      "chromatic_adaptation": "Bradford"
    }
  },
  "76": {
    "class_type": "PreviewImage",
    "inputs": { "images": ["75", 0] },
    "_meta": { "title": "Rec.709 Final Preview" }
  },

  "80": {
    "class_type": "PreviewImage",
    "inputs": { "images": ["60", 1] },
    "_meta": { "title": "Waveform QC" }
  },
  "81": {
    "class_type": "PreviewImage",
    "inputs": { "images": ["20", 1] },
    "_meta": { "title": "Depth Map" }
  }
}
