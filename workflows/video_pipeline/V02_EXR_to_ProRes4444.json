{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "FF_Train_01.png"
    }
  },
  "2": {
    "class_type": "PrepareImageHighBitDepth",
    "inputs": {
      "image": ["1", 0],
      "input_is_srgb": true,
      "add_headroom": 0.1,
      "deband_strength": 1.0
    }
  },
  "3": {
    "class_type": "ColorGradingController",
    "inputs": {
      "image": ["2", 0],
      "exposure": 0.2,
      "contrast": 1.1,
      "lift": 0.0,
      "gamma": 1.0,
      "gain": 1.05,
      "saturation": 1.1,
      "input_is_linear": true
    },
    "_meta": { "title": "Slight Grade Boost" }
  },
  "4": {
    "class_type": "AnimatedPanAndScan",
    "inputs": {
      "images": ["3", 0],
      "output_size": "1080p (1920×1080)",
      "custom_width": 1920,
      "custom_height": 1080,
      "start_x": -100,
      "start_y": -50,
      "start_zoom": 1.2,
      "end_x": 100,
      "end_y": 50,
      "end_zoom": 1.0,
      "easing": "ease_in_out",
      "loop_mode": "none",
      "start_frame": 0,
      "end_frame": 47,
      "rotation_start": -2.0,
      "rotation_end": 2.0
    },
    "_meta": { "title": "Pan + Slight Rotation (2s)" }
  },
  "5": {
    "class_type": "HighBitDepthVideoEncoder",
    "inputs": {
      "images": ["4", 0],
      "filename_prefix": "V02_ProRes4444",
      "codec": "ProRes 4444 (MOV)",
      "frame_rate": 24.0,
      "quality": 5
    },
    "_meta": { "title": "ProRes 4444 Output" }
  },
  "6": {
    "class_type": "HighBitDepthVideoEncoder",
    "inputs": {
      "images": ["4", 0],
      "filename_prefix": "V02_ProRes4444XQ",
      "codec": "ProRes 4444 XQ (MOV)",
      "frame_rate": 24.0,
      "quality": 3
    },
    "_meta": { "title": "ProRes 4444 XQ Output" }
  },
  "7": {
    "class_type": "PreviewImage",
    "inputs": {
      "images": ["4", 0]
    },
    "_meta": { "title": "Animation Preview" }
  }
}
