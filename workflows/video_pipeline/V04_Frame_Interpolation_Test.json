{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "FF_Train_01.png"
    }
  },
  "2": {
    "class_type": "AnimatedPanAndScan",
    "inputs": {
      "images": ["1", 0],
      "output_size": "1080p (1920×1080)",
      "custom_width": 1920,
      "custom_height": 1080,
      "start_x": -200,
      "start_y": 0,
      "start_zoom": 1.3,
      "end_x": 200,
      "end_y": 0,
      "end_zoom": 1.3,
      "easing": "ease_in_out",
      "loop_mode": "none",
      "start_frame": 0,
      "end_frame": 31,
      "rotation_start": 0.0,
      "rotation_end": 0.0
    },
    "_meta": { "title": "Generate 32 frames @ 16fps (2s)" }
  },
  "3": {
    "class_type": "FrameInterpolator",
    "inputs": {
      "images": ["2", 0],
      "source_fps": 16.0,
      "target_fps": 24.0,
      "method": "optical_flow"
    },
    "_meta": { "title": "Interpolate 16fps → 24fps" }
  },
  "4": {
    "class_type": "HighBitDepthVideoEncoder",
    "inputs": {
      "images": ["2", 0],
      "filename_prefix": "V04_Original_16fps",
      "codec": "ProRes 4444 (MOV)",
      "frame_rate": 16.0,
      "quality": 5
    },
    "_meta": { "title": "Original 16fps ProRes" }
  },
  "5": {
    "class_type": "HighBitDepthVideoEncoder",
    "inputs": {
      "images": ["3", 0],
      "filename_prefix": "V04_Interpolated_24fps",
      "codec": "ProRes 4444 (MOV)",
      "frame_rate": 24.0,
      "quality": 5
    },
    "_meta": { "title": "Interpolated 24fps ProRes" }
  },
  "6": {
    "class_type": "PreviewImage",
    "inputs": {
      "images": ["3", 0]
    },
    "_meta": { "title": "Interpolated Frames Preview" }
  }
}
